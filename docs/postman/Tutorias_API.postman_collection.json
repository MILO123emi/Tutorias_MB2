              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tutorias"
              ]
            },
            "description": "Solo estudiantes. Responde 409 si el bloque ya fue reservado.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tutor_id\": \"{{tutor_id}}\",\n  \"materia_id\": \"{{materia_id}}\",\n  \"fecha\": \"{{fecha}}\",\n  \"hora_inicio\": 14,\n  \"tema\": \"Derivadas implícitas\",\n  \"descripcion\": \"Quiero repasar ejercicios.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('tutoria_id', pm.response.json().data.id); }"
                ]
              }
            }
          ]
        },
