  "item": [
    {
      "name": "Sesión",
      "item": [
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda el token en la variable de la colección.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@unicah.edu\",\n  \"password\": \"tu-contraseña\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "const token = datos.token || datos.access_token || (datos.data && datos.data.token);",
                  "if (token) { pm.collectionVariables.set('token', token); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bloques y reservas",
      "item": [
        {
          "name": "Bloques libres de un tutor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tutores/{{tutor_id}}/bloques?fecha={{fecha}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tutores",
                "{{tutor_id}}",
                "bloques"
              ],
              "query": [
                {
                  "key": "fecha",
                  "value": "{{fecha}}"
                }
              ]
            },
            "description": "Fecha entre hoy y los próximos 7 días, sin domingos.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reservar tutoría",
          "request": {
            "method": "POST",
