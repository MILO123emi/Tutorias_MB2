{
  "info": {
    "name": "Tutorías API v1",
    "description": "Bloques, reservas, cancelación y asistencia.\n\nErrores: siempre {\"message\": \"...\"}. 401 sin sesión, 403 sin permiso, 404 no existe, 409 estado o bloque en conflicto, 422 validación (agrega \"errors\" por campo), 429 demasiados intentos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tutor_id",
      "value": "1"
    },
    {
      "key": "materia_id",
      "value": "1"
    },
    {
      "key": "tutoria_id",
      "value": "1"
    },
    {
      "key": "fecha",
      "value": "2026-11-25"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "perfil_tutor_id",
      "value": "1"
    },
    {
      "key": "solicitud_foto_id",
      "value": "1"
    }
